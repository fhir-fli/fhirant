# See https://www.dartlang.org/guides/libraries/private-files

# Files and directories created by pub
.dart_tool/
.DS_Store
**/.DS_Store
.packages
build/

*pubspec_overrides.yaml

# IDE files
.idea/
*.iml

# Dart support files
*.pubspec.lock

# Flutter-generated plugin metadata
**/.flutter-plugins-dependencies

# Local runtime database created by the server on first run
data/

# Play Store upload certificates: leftovers from the abandoned Play route
# (release is a direct APK). Public certs, but they are not repo content.
packages/fhirant/play_store/upload_certificate.der
packages/fhirant/play_store/upload_certificate.pem

# Coverage output. CI produces it in a separate job and uploads it as an
# artifact; a local `dart test --coverage` or `flutter test --coverage`
# leaves it here.
coverage/

# TLS material is generated on first run, never committed. A key pair used
# to live in packages/fhirant_server/assets/; it is in the history and must
# be treated as compromised.
*.pem

# Lock files of the regular (library) packages and of the root aggregation
# pubspec are not tracked. dart-lang/site-www, tools/pub/private-files.md
# (read 2026-09-19): "For regular packages, don't commit the pubspec.lock
# file." The two applications, packages/fhirant and packages/fhirant_server,
# keep theirs ("For application packages, we recommend that you commit the
# pubspec.lock file."). REVIEW-2026-09-17 S8.
/pubspec.lock
packages/fhirant_db/pubspec.lock
packages/fhirant_logging/pubspec.lock
packages/fhirant_secure_storage/pubspec.lock

# The differential run's scratch store and server log: a database, a JWT
# secret and a log, regenerated by every run (tool/differential).
tool/differential/results/fhirant_db/
tool/differential/results/*.log

<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of this app leaves the phone by backup or device transfer.

  android:allowBackup="false" (AndroidManifest.xml) is the switch for
  Android 11 and lower. Android 12 behaviour changes page (read 2026-10-18,
  verbatim): "On devices from some device manufacturers, specifying
  android:allowBackup="false" does disable backups to Google Drive, but
  doesn't disable D2D transfers for the app." The app holds a patient record
  and its server log, so both modes exclude every private directory.

  Auto Backup guide (read 2026-10-18, verbatim): "If you specify a
  directory, then the rule applies to all files in the directory and
  recursive subdirectories"; `root` is "the directory on the file system
  where all private files belonging to this app are stored". `device_root`
  is the device-protected copy of it and `external` getExternalFilesDir().
  Found on the phone run of fhirant REVIEW-2026-10-17.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
